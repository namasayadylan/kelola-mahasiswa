<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="page-subtitle">Selamat Datang Admin di Halaman Dashboard</p>
        
    </div>
</div>

<div class="cards">
    <div class="card">
        <div>
            <div class="card-number">{{ totalMahasiswa }}</div>
            <div class="card-label">Total Mahasiswa</div>
        </div>
    </div>
    <div class="card">
        <div>
            <div class="card-number">{{ totalProdi }}</div>
            <div class="card-label">Total Program Studi</div>
        </div>
    </div>
</div>
